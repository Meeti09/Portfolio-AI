# ---- Application ----------------------------------------------------------
APP_NAME=investment-engine-api
DEBUG=false

# ---- Database -------------------------------------------------------------
# These must match the grants given to the app user (see sql/00_bootstrap.sql).
# On Render these become service environment variables instead of this file:
# DB_HOST/DB_PORT/DB_USER/DB_PASSWORD point at your managed MySQL, and
# DB_SSL_MODE is PREFERRED for Railway or REQUIRED (+ DB_SSL_CA) for Aiven.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=investment_engine
DB_USER=inv_app
DB_PASSWORD=change_me
DB_SSL_MODE=PREFERRED
DB_SSL_CA=

# ---- Auth / JWT -----------------------------------------------------------
# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace_with_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- CORS -----------------------------------------------------------------
# Comma separated list of allowed origins. Production must list the deployed
# frontend, e.g. https://portfolio-ai-ten-steel.vercel.app (on Render this is
# the CORS_ORIGINS environment variable, pre-filled in render.yaml).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173